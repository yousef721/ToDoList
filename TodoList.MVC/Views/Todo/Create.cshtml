@model CreateTodoViewModel

@{
    ViewData["Title"] = "Create Todo";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="card border-0 shadow-sm">

            <!-- Header -->
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-semibold">
                    <i class="bi bi-plus-circle me-2"></i>Create New Todo
                </h4>
            </div>

            <!-- Body -->
            <div class="card-body p-4">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Validation -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title"
                               class="form-control"
                               placeholder="What needs to be done?" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Add more details (optional)..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Date + Priority -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label fw-semibold"></label>

                            <input asp-for="DueDate"
                                   type="date"
                                   class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold"></label>

                            <select asp-for="Priority"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<TodoPriority>()">
                            </select>

                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2">

                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-check-lg me-1"></i>Create Todo
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}