@model TodoListItemViewModel

@{
    ViewData["Title"] = "Todo Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="card border-0 shadow-sm">

            <!-- Header -->
            <div class="card-header py-3 @(Model.IsCompleted ? "bg-success text-white" : "bg-primary text-white")">
                <div class="d-flex justify-content-between align-items-center">

                    <h4 class="mb-0 fw-semibold">
                        <i class="bi @(Model.IsCompleted ? "bi-check-circle-fill" : "bi-clock") me-2"></i>

                        @(Model.IsCompleted ? "Completed" : "Pending") Todo
                    </h4>

                    <span class="@Model.PriorityBadgeClass">
                        @Model.Priority
                    </span>

                </div>
            </div>

            <!-- Body -->
            <div class="card-body p-4">

                <!-- Title -->
                <h5 class="fw-bold mb-3 @(Model.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                    @Model.Title
                </h5>

                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-4">
                        @Model.Description
                    </p>
                }

                <!-- Info Grid -->
                <div class="row g-3 mb-4">

                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Status</div>

                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check me-1"></i>Completed
                            </span>
                        }
                        else if (Model.IsOverdue)
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-exclamation me-1"></i>Overdue
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-hourglass me-1"></i>Pending
                            </span>
                        }
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Due Date</div>
                        <div class="fw-semibold @(Model.IsOverdue ? "text-danger" : "")">
                            @(Model.DueDate?.ToString("MMM dd, yyyy") ?? "—")
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Created</div>
                        <div class="fw-semibold">
                            @Model.CreatedDate.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="text-muted small">Updated</div>
                        <div class="fw-semibold">
                            @Model.UpdatedDate.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                </div>

                <!-- Actions -->
                <div class="d-flex gap-2 flex-wrap">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>

                    <form asp-action="ToggleCompleted"
                          asp-route-id="@Model.Id"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn @(Model.IsCompleted ? "btn-outline-warning" : "btn-success")">

                            <i class="bi @(Model.IsCompleted ? "bi-arrow-counterclockwise" : "bi-check-lg") me-1"></i>

                            @(Model.IsCompleted ? "Mark Pending" : "Mark Done")
                        </button>

                    </form>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary ms-auto">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>

                </div>

            </div>
        </div>

    </div>
</div>